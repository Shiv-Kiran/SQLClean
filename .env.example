# Required
GOOGLE_API_KEY=your_google_ai_studio_key

# Optional runtime tuning
SQLCLEAN_MODEL=gemini-2.5-flash
SQLCLEAN_TEMPERATURE=0.1
SQLCLEAN_MAX_RETRIES=2
SQLCLEAN_CANDIDATE_COUNT=3
SQLCLEAN_EXECUTION_VERIFY=false
SQLCLEAN_EXPLAIN_ANALYZE=false

# Optional PostgreSQL verifier (required for execution verification mode)
SQLCLEAN_PG_DSN=postgresql://postgres:postgres@localhost:5432/sqlclean
SQLCLEAN_PG_CONNECT_TIMEOUT_SEC=5
SQLCLEAN_PG_STATEMENT_TIMEOUT_MS=2500

# Optional safety thresholds
SQLCLEAN_MAX_SQL_LENGTH=50000
SQLCLEAN_MAX_JOINS=12
SQLCLEAN_MAX_SUBQUERIES=8
SQLCLEAN_MAX_CTES=8
